# Backend API base URL (use your machine's LAN IP when testing on a real phone;
# Android emulator can use http://10.0.2.2:5000/api)
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth client IDs (Google Cloud Console -> APIs & Services -> Credentials)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
