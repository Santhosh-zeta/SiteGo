{
  "name": "sitego-backend",
  "version": "1.0.0",
  "description": "SiteGo - Construction Site Monitoring & Management Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node api.js && node server.js",
    "dev": "node api.js && nodemon server.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/seed.js",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\"",
    "clean": "rm -rf node_modules package-lock.json",
    "reinstall": "npm run clean && npm install"
  },
  "keywords": [
    "construction",
    "monitoring",
    "management",
    "site",
    "attendance",
    "geofencing",
    "ai",
    "tensorflow",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/s3-request-presigner": "^3.478.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.4.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "sharp": "^0.33.1",
    "socket.io": "^4.6.2"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/sitego-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/sitego-backend/issues"
  },
  "homepage": "https://github.com/yourusername/sitego-backend#readme"
}
